#ifndef SECRETS_H
#define SECRETS_H

// ---------------------------------------------------------------------------
// Copy to secrets.h and fill in, or let tools/configure.py write it for you:
//
//     python3 tools/configure.py --address "221B Baker Street, London" \
//                                --ssid MyNetwork --password hunter2
//
// secrets.h is gitignored. Keep it that way.
// ---------------------------------------------------------------------------

#define WIFI_SSID   "your-network"
#define WIFI_PASS   "your-password"

// The centre of the scope. Everything is drawn relative to this point.
#define HOME_NAME   "Somewhere"
#define HOME_LAT    51.0447
#define HOME_LON    -114.0719
#define RADIUS_KM   15.0

// Timezone in POSIX TZ form, used for the backlight schedule.
//
// If your region observes DST you MUST include the rule — a bare offset runs
// an hour slow for half the year and the schedule fires an hour late. If it
// does not, a bare offset is correct and a DST rule would break you in winter.
//
//   Alberta            MDT6                      (UTC-6 year round since 2026)
//   Saskatchewan       CST6                      (never observed DST)
//   Arizona            MST7                      (no DST)
//   US Mountain        MST7MDT,M3.2.0,M11.1.0
//   US Pacific         PST8PDT,M3.2.0,M11.1.0
//   UK                 GMT0BST,M3.5.0/1,M10.5.0
//
// Check yours: `TZ=<string> date` should match `TZ=<Region/City> date` in both
// July and January.
#define HOME_TZ     "MDT6"

#endif // SECRETS_H
